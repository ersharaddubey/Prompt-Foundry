{
  "expo": {
    "name": "Prompt Foundry",
    "slug": "prompt-foundry",
    "version": "1.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "somyalaya",
    "android": {
      "package": "com.promptfoundry.app",
      "versionCode": 43,
      "adaptiveIcon": {
        "backgroundColor": "#0f0f12"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.promptfoundry.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f0f12"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7c3aed"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      "./plugins/withAppaloo.js",
      "@sentry/react-native"
    ],
    "owner": "promptwala",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1deb7694-0e6d-4c09-a7f6-2b040105aece"
      }
    }
  }
}
